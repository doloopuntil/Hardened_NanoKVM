From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hardened NanoKVM kernel port <noreply@local>
Date: Sat, 24 Oct 2026 14:00:00 +0200
Subject: [PATCH 8/9] cvitek: do not force the Cvitek ION glue

soph_sys allocates media memory itself, so the kernel is built without
ION. ARCH_CVITEK selected ION_CVITEK regardless, which would build the
Cvitek ION glue against an ION core that is not there.
---
 arch/riscv/mach-cvitek/Kconfig | 1 -
 1 file changed, 1 deletion(-)

diff --git a/arch/riscv/mach-cvitek/Kconfig b/arch/riscv/mach-cvitek/Kconfig
index 3192588..2272b0a 100644
--- a/arch/riscv/mach-cvitek/Kconfig
+++ b/arch/riscv/mach-cvitek/Kconfig
@@ -1,6 +1,5 @@
 config ARCH_CVITEK
 	bool "Cvitek SoC Family"
-	select ION_CVITEK
 	select SCHED_CVITEK
 	help
 	  This enables support for Cvitek SoC family.
