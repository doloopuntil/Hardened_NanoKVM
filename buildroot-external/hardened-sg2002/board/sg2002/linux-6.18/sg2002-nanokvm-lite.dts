/*
 * NanoKVM Lite: LicheeRV Nano E (SG2002, 100M Ethernet, no Wi-Fi) with the
 * HDMI-to-CSI board. Pin setup follows the vendor U-Boot cvi_board_init.c.
 */

/dts-v1/;

#include "sophgo/sg2002.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/* CSI PHY resets (bits in the 0x3003000 block) that cv18xx-reset.h does not name */
#define RST_CSIPHY0		70
#define RST_CSIPHY0RST_APB	71
#define RST_CSIPHY1		72
#define RST_CSIPHY1RST_APB	73

/ {
	model = "Sipeed NanoKVM Lite";
	compatible = "sipeed,nanokvm-lite", "sipeed,licheerv-nano-e",
		     "sipeed,licheerv-nano", "sophgo,sg2002";

	aliases {
		gpio0 = &gpio0;
		gpio1 = &gpio1;
		gpio2 = &gpio2;
		gpio3 = &gpio3;
		gpio4 = &gpio4;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		i2c1 = &i2c1;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* C906L firmware, as in the vendor memmap; empty until the core gets a job */
		c906l_rtos: rtos@8fe00000 {
			reg = <0x8fe00000 0x200000>;
			no-map;
		};

		/* soph_sys carveout, mapped for cached access. Size only, as on 5.10: U-Boot may */
		/* relocate the DTB into a fixed region, and soph_sys zeroes it at probe. */
		media_carveout: media {
			size = <0x4b00000>;
			alignment = <0x100000>;
			alloc-ranges = <0x80000000 0xfe00000>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-user {
			label = "User Key";
			linux,code = <KEY_DISPLAYTOGGLE>;
			debounce-interval = <10>;
			gpios = <&porta 30 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&user_led_cfg>;

		led-user {
			label = "nanokvm:blue:user";
			gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "activity";
		};
	};

	/* OLED on the Full and PCIe; probed by kvm_system */
	i2c5: i2c-gpio {
		compatible = "i2c-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&i2c5_cfg>;
		scl-gpios = <&porta 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&porta 27 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&osc {
	clock-frequency = <25000000>;
};

&pinctrl {
	uart0_cfg: uart0-cfg {
		uart0-pins {
			pinmux = <PINMUX(PIN_UART0_TX, 0)>,
				 <PINMUX(PIN_UART0_RX, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	sdhci0_cfg: sdhci0-cfg {
		sdhci0-clk-pins {
			pinmux = <PINMUX(PIN_SD0_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <3300>;
		};

		sdhci0-cmd-pins {
			pinmux = <PINMUX(PIN_SD0_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-data-pins {
			pinmux = <PINMUX(PIN_SD0_D0, 0)>,
				 <PINMUX(PIN_SD0_D1, 0)>,
				 <PINMUX(PIN_SD0_D2, 0)>,
				 <PINMUX(PIN_SD0_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-cd-pins {
			pinmux = <PINMUX(PIN_SD0_CD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	/* A18/A19 (JTAG pads) as UART1, A28/A29 as UART2: the two user serial ports */
	uart1_cfg: uart1-cfg {
		uart1-pins {
			pinmux = <PINMUX(PIN_JTAG_CPU_TMS, 6)>,
				 <PINMUX(PIN_JTAG_CPU_TCK, 6)>;
			power-source = <3300>;
		};
	};

	uart2_cfg: uart2-cfg {
		uart2-pins {
			pinmux = <PINMUX(PIN_IIC0_SCL, 2)>,
				 <PINMUX(PIN_IIC0_SDA, 2)>;
			power-source = <3300>;
		};
	};

	/* HDMI bridge I2C: PWR_GPIO6/8 in vendor names */
	i2c4_cfg: i2c4-cfg {
		i2c4-pins {
			pinmux = <PINMUX(PIN_PWR_WAKEUP0, 5)>,
				 <PINMUX(PIN_PWR_BUTTON1, 5)>;
			power-source = <1800>;
		};
	};

	/* A15 SCL, A27 SDA */
	i2c5_cfg: i2c5-cfg {
		i2c5-pins {
			pinmux = <PINMUX(PIN_SPK_EN, 3)>,
				 <PINMUX(PIN_EMMC_DAT3, 3)>;
			power-source = <3300>;
		};
	};

	/* RX0N as CAM_MCLK1 and PWR_GPIO1 as the bridge reset, as the vendor U-Boot sets them */
	mipi_rx_cfg: mipi-rx-cfg {
		cam-mclk1-pins {
			pinmux = <PINMUX(PIN_MIPIRX0N, 5)>;
			power-source = <1800>;
		};

		snsr-reset-pins {
			pinmux = <PINMUX(PIN_PWR_GPIO1, 0)>;
			power-source = <1800>;
		};
	};

	user_led_cfg: user-led-cfg {
		user-led-pins {
			pinmux = <PINMUX(PIN_SD0_PWR_EN, 3)>;
			power-source = <3300>;
		};
	};

	/* A22 OLED reset, A23 power key, A24 power LED, A25 reset key, A26 Wi-Fi enable */
	kvm_gpio_cfg: kvm-gpio-cfg {
		kvm-gpio-pins {
			pinmux = <PINMUX(PIN_EMMC_CLK, 3)>,
				 <PINMUX(PIN_EMMC_CMD, 3)>,
				 <PINMUX(PIN_EMMC_DAT1, 3)>,
				 <PINMUX(PIN_EMMC_DAT0, 3)>,
				 <PINMUX(PIN_EMMC_DAT2, 3)>;
			power-source = <3300>;
		};
	};
};

&gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&kvm_gpio_cfg>;
};

&porta {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "user-led", "i2c5-scl",
		"", "", "uart1", "uart1", "", "", "oled-reset", "atx-power",
		"atx-power-led", "atx-reset", "wifi-enable", "i2c5-sda",
		"uart2", "uart2", "user-key", "";

	/* The Full and PCIe boards' OLED stays out of reset */
	oled-reset-hog {
		gpio-hog;
		gpios = <22 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "oled-reset";
	};
};

&portb {
	gpio-line-names =
		"", "", "", "hdmi-reset", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&sdhci0 {
	pinctrl-0 = <&sdhci0_cfg>;
	pinctrl-names = "default";
	status = "okay";
	bus-width = <4>;
	no-1-8-v;
	no-mmc;
	no-sdio;
	disable-wp;
};

&uart0 {
	pinctrl-0 = <&uart0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&uart1 {
	pinctrl-0 = <&uart1_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

&ephy_init {
	status = "okay";
};

&mdio {
	status = "okay";
};

&gmac0 {
	status = "okay";
};

/* Kept so /dev/i2c-1 exists for kvm_system; its pads stay SDIO */
&i2c1 {
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_cfg>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&usb {
	dr_mode = "peripheral";
	status = "okay";
};

&tpu {
	status = "disabled";
};

/*
 * Media blocks for the osdrv modules (hardened-soph-media), from the vendor
 * soph_base.dtsi and soph_base_riscv.dtsi with mainline clock and reset IDs.
 * Vendor interrupt numbers are PLIC numbers: SOC_PERIPHERAL_IRQ(n - 16).
 */
&{/soc} {
	/* RTC-domain GPIO bank (vendor PWR_GPIO, "porte") */
	gpio4: gpio@5021000 {
		compatible = "snps,dw-apb-gpio";
		reg = <0x05021000 0x1000>;
		#address-cells = <1>;
		#size-cells = <0>;

		porte: gpio-controller@0 {
			compatible = "snps,dw-apb-gpio-port";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
			reg = <0>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <SOC_PERIPHERAL_IRQ(54) IRQ_TYPE_LEVEL_HIGH>;
			gpio-line-names =
				"", "hdmi-bridge-reset", "", "", "", "", "", "",
				"", "", "", "", "", "", "", "",
				"", "", "", "", "", "", "", "",
				"", "", "", "", "", "", "", "";
		};
	};

	sys {
		compatible = "cvitek,sys";
		memory-region = <&media_carveout>;
	};

	base@a0c8000 {
		compatible = "cvitek,base";
		reg = <0x0a0c8000 0x20>;
		reg-names = "vip_sys";
		/* eFuse (base_uid) and the media clocks the vendor clk driver marks critical; */
		/* soph_base keeps them on while loaded. */
		clocks = <&clk CLK_EFUSE>, <&clk CLK_APB_EFUSE>,
			 <&clk CLK_CFG_REG_VIP>, <&clk CLK_VIP_IP0>, <&clk CLK_VIP_IP1>,
			 <&clk CLK_VIP_IP2>, <&clk CLK_VIP_IP3>, <&clk CLK_CSI0_RX_VIP>,
			 <&clk CLK_CSI1_RX_VIP>, <&clk CLK_CSI_BE_VIP>, <&clk CLK_RAW_VIP>,
			 <&clk CLK_OSDC_VIP>, <&clk CLK_CAM0_VIP>, <&clk CLK_PAD_VI_VIP>,
			 <&clk CLK_PAD_VI1_VIP>, <&clk CLK_PAD_VI2_VIP>, <&clk CLK_LVDS0_VIP>,
			 <&clk CLK_LVDS1_VIP>, <&clk CLK_IVE_VIP>, <&clk CLK_CAM0_200>;
	};

	cif@a0c2000 {
		compatible = "cvitek,cif";
		reg = <0x0a0c2000 0x2000>, <0x0a0d0000 0x1000>,
		      <0x0a0c4000 0x2000>, <0x0a0c6000 0x2000>,
		      <0x03001c30 0x30>;
		reg-names = "csi_mac0", "csi_wrap0", "csi_mac1", "csi_mac2", "pad_ctrl";
		interrupts = <SOC_PERIPHERAL_IRQ(10) IRQ_TYPE_LEVEL_HIGH>,
			     <SOC_PERIPHERAL_IRQ(11) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "csi0", "csi1";
		snsr-reset-gpios = <&porte 1 GPIO_ACTIVE_LOW>;
		resets = <&rst RST_CSIPHY0>, <&rst RST_CSIPHY1>,
			 <&rst RST_CSIPHY0RST_APB>, <&rst RST_CSIPHY1RST_APB>;
		reset-names = "phy0", "phy1", "phy-apb0", "phy-apb1";
		clocks = <&clk CLK_CAM0>, <&clk CLK_CAM1>, <&clk CLK_SRC_VIP_SYS_2>,
			 <&clk CLK_MIPIMPLL>, <&clk CLK_DISPPLL>, <&clk CLK_FPLL>;
		clock-names = "clk_cam0", "clk_cam1", "clk_sys_2",
			      "clk_mipimpll", "clk_disppll", "clk_fpll";
		pinctrl-names = "default";
		pinctrl-0 = <&mipi_rx_cfg>;
	};

	vi@a000000 {
		compatible = "cvitek,vi";
		reg = <0x0a000000 0x80000>;
		interrupts = <SOC_PERIPHERAL_IRQ(8) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "isp";
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>,
			 <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>,
			 <&clk CLK_AXI_VIP>, <&clk CLK_CSI_BE_VIP>,
			 <&clk CLK_RAW_VIP>, <&clk CLK_ISP_TOP_VIP>,
			 <&clk CLK_CSI_MAC0_VIP>, <&clk CLK_CSI_MAC1_VIP>,
			 <&clk CLK_CSI_MAC2_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_sys_3",
			      "clk_axi", "clk_csi_be", "clk_raw", "clk_isp_top",
			      "clk_csi_mac0", "clk_csi_mac1", "clk_csi_mac2";
		clock-freq-vip-sys1 = <300000000>;
	};

	vpss@a080000 {
		compatible = "cvitek,vpss";
		reg = <0x0a080000 0x10000>, <0x0a0d1000 0x100>;
		reg-names = "sc";
		interrupts = <SOC_PERIPHERAL_IRQ(9) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "sc";
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>,
			 <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_IMG_D_VIP>,
			 <&clk CLK_IMG_V_VIP>, <&clk CLK_SC_TOP_VIP>,
			 <&clk CLK_SC_D_VIP>, <&clk CLK_SC_V1_VIP>,
			 <&clk CLK_SC_V2_VIP>, <&clk CLK_SC_V3_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_img_d",
			      "clk_img_v", "clk_sc_top", "clk_sc_d", "clk_sc_v1",
			      "clk_sc_v2", "clk_sc_v3";
		clock-freq-vip-sys1 = <300000000>;
	};

	/* No display; the middleware opens /dev/cvi-vo at start-up */
	vo {
		compatible = "cvitek,vo";
		clocks = <&clk CLK_DISP_VIP>, <&clk CLK_DSI_MAC_VIP>, <&clk CLK_BT_VIP>;
		clock-names = "clk_disp", "clk_dsi", "clk_bt";
	};

	dwa@a0c0000 {
		compatible = "cvitek,dwa";
		reg = <0x0a0c0000 0x1000>;
		reg-names = "dwa";
		interrupts = <SOC_PERIPHERAL_IRQ(12) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dwa";
		clocks = <&clk CLK_SRC_VIP_SYS_0>, <&clk CLK_SRC_VIP_SYS_1>,
			 <&clk CLK_SRC_VIP_SYS_2>, <&clk CLK_SRC_VIP_SYS_3>,
			 <&clk CLK_SRC_VIP_SYS_4>, <&clk CLK_DWA_VIP>;
		clock-names = "clk_sys_0", "clk_sys_1", "clk_sys_2", "clk_sys_3",
			      "clk_sys_4", "clk_dwa";
		clock-freq-vip-sys1 = <300000000>;
	};

	rgn {
		compatible = "cvitek,rgn";
	};

	vcodec@b020000 {
		compatible = "cvitek,asic-vcodec";
		reg = <0x0b020000 0x10000>, <0x0b010000 0x10000>, <0x0b030000 0x100>,
		      <0x0b058000 0x100>, <0x0b050000 0x400>;
		reg-names = "h265", "h264", "vc_ctrl", "vc_sbm", "vc_addr_remap";
		interrupts = <SOC_PERIPHERAL_IRQ(6) IRQ_TYPE_LEVEL_HIGH>,
			     <SOC_PERIPHERAL_IRQ(5) IRQ_TYPE_LEVEL_HIGH>,
			     <SOC_PERIPHERAL_IRQ(7) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "h265", "h264", "sbm";
		clocks = <&clk CLK_AXI_VIDEO_CODEC>,
			 <&clk CLK_H264C>, <&clk CLK_APB_H264C>,
			 <&clk CLK_H265C>, <&clk CLK_APB_H265C>,
			 <&clk CLK_VC_SRC0>, <&clk CLK_VC_SRC1>,
			 <&clk CLK_VC_SRC2>, <&clk CLK_CFG_REG_VC>;
		clock-names = "clk_axi_video_codec",
			      "clk_h264c", "clk_apb_h264c",
			      "clk_h265c", "clk_apb_h265c",
			      "clk_vc_src0", "clk_vc_src1",
			      "clk_vc_src2", "clk_cfg_reg_vc";
	};

	jpu@b000000 {
		compatible = "cvitek,asic-jpeg";
		reg = <0x0b000000 0x300>, <0x0b030000 0x100>, <0x0b058000 0x100>;
		reg-names = "jpeg", "vc_ctrl", "vc_sbm";
		interrupts = <SOC_PERIPHERAL_IRQ(4) IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "jpeg";
		clocks = <&clk CLK_AXI_VIDEO_CODEC>,
			 <&clk CLK_JPEG>, <&clk CLK_APB_JPEG>,
			 <&clk CLK_VC_SRC0>, <&clk CLK_VC_SRC1>,
			 <&clk CLK_VC_SRC2>, <&clk CLK_CFG_REG_VC>;
		clock-names = "clk_axi_video_codec",
			      "clk_jpeg", "clk_apb_jpeg",
			      "clk_vc_src0", "clk_vc_src1",
			      "clk_vc_src2", "clk_cfg_reg_vc";
		resets = <&rst RST_JPEG>;
		reset-names = "jpeg";
	};

	cvi-vc-drv@b030000 {
		compatible = "cvitek,cvi_vc_drv";
		reg = <0x0b030000 0x100>, <0x0b058000 0x100>, <0x0b050000 0x400>;
		reg-names = "vc_ctrl", "vc_sbm", "vc_addr_remap";
	};
};
