# NanoKVM on top of the riscv defconfig and licheerv's linux.fragment.
# Everything the system needs is built in; modules are only for the media drivers.

# Build for speed (kernel-6x-migration-plan.md, 6.4.1)
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_MAE=y
CONFIG_ERRATA_THEAD_CMO=y

# Full preemption, as the vendor 5.10: the VI threads and the polling codecs share one core
# CONFIG_PREEMPT_NONE is not set
CONFIG_PREEMPT=y

# Flat memory model: SPARSEMEM_EXTREME allocates a 16 MiB section root table for 56-bit PAs
CONFIG_FLATMEM_MANUAL=y
# CONFIG_SPARSEMEM_MANUAL is not set

# Hardening carried over from 5.10
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_USER_NS is not set
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# The rootfs has no initramfs and does not mount /dev itself
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# The FSBL arms the watchdog; the kernel must adopt it before user space runs
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# USB device: HID, mass storage, NCM, RNDIS through configfs
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y

# Platform devices used by init scripts and kvm_system
CONFIG_EXPERT=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_GPIO=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
CONFIG_RTC_DRV_CV1800=y
CONFIG_SOPHGO_CV1800_RTCSYS=y
CONFIG_CV1800_THERMAL=y
CONFIG_DEVMEM=y
CONFIG_MAGIC_SYSRQ=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Networking: nftables firewall (S40firewall), WireGuard, Tailscale (nftables mode)
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
# No xtables: the arch defconfig's container options (bridge netfilter, IPVS) select it
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_IP_VS is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_NETFILTER_XT_MARK is not set
# CONFIG_NETFILTER_XT_MATCH_ADDRTYPE is not set
# CONFIG_NETFILTER_XT_MATCH_CONNTRACK is not set
# CONFIG_NETFILTER_XTABLES is not set
CONFIG_WIREGUARD=y
CONFIG_TUN=y

# Ethernet built in: the rootfs carries no modules for it.
# The CV1800B MAC binds through dwmac-generic; dwmac-sophgo only matches SG2042/SG2044.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
CONFIG_MDIO_BUS_MUX=y
CONFIG_MDIO_BUS_MUX_MMIOREG=y

# Not on the Lite, or replaced: no audio, no display, no CMA (the media carveout comes in Phase 2)
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_CMA is not set
# CONFIG_DMABUF_HEAPS is not set

# Other RISC-V platforms in the arch defconfig
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_ARCH_STARFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_PCI is not set
# CONFIG_DRM_VIRTIO_GPU is not set
