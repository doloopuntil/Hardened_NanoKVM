+/* Same text as the vendor ION debugfs summary, which kvm_mmf and kvm_vision parse. */
+int sys_mem_proc_show(struct seq_file *m, void *v)
+{
+	struct sys_mem_buf *buf;
+	u64 rate = 0;
+
+	mutex_lock(&sys_mem_lock);
+	if (sys_mem_size)
+		rate = DIV_ROUND_UP_ULL((u64)sys_mem_used * 100, sys_mem_size);
+	seq_puts(m, "Summary:\n");
+	seq_printf(m, "[0] carveout heap size:%zu bytes, used:%zu bytes\n",
+		   sys_mem_size, sys_mem_used);
+	seq_printf(m, "usage rate:%llu%%, memory usage peak %zu bytes\n", rate, sys_mem_peak);
+	seq_printf(m, "\nDetails:\n%16s %16s %16s %16s %16s\n", "heap_id",
+		   "alloc_buf_size", "phy_addr", "kmap_cnt", "buffer name");
+	list_for_each_entry(buf, &sys_mem_bufs, list)
+		seq_printf(m, "%16d %16zu %16llx %16d %16s\n", 0, buf->size, buf->paddr, 1, buf->name);
+	mutex_unlock(&sys_mem_lock);
+	seq_puts(m, "\n");
 	return 0;
 }
