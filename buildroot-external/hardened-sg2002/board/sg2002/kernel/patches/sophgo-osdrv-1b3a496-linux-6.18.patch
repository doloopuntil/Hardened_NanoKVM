+/* Reads the UID once; the eFuse clocks are on with the node's other clocks. */
+static void base_read_uid(void)
+{
+	void __iomem *shadow;
+
+	shadow = ioremap(EFUSE_SHADOW_BASE, 0x14);
+	if (shadow) {
+		base_uid[0] = ioread32(shadow + 0x0c);
+		base_uid[1] = ioread32(shadow + 0x10);
+		base_uid_valid = true;
+		iounmap(shadow);
+	}
+}
