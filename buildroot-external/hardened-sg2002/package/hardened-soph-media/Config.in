config BR2_PACKAGE_HARDENED_SOPH_MEDIA
	bool "Sophgo media kernel modules (osdrv)"
	depends on BR2_LINUX_KERNEL
	help
	  The video capture, scaling and codec drivers from sophgo/osdrv
	  (soph_sys, soph_base, soph_mipi_rx, soph_vi, soph_vpss,
	  soph_dwa, soph_vo, soph_rgn, soph_vcodec, soph_jpeg,
	  soph_vc_driver), with the Hardened osdrv patches and the
	  Linux 6.18 port. Installed under /lib/modules/<version>/extra.

comment "Sophgo media kernel modules need a Linux kernel"
	depends on !BR2_LINUX_KERNEL
